{
  "name": "@zakkster/lite-o1",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "version": "0.4.0",
  "description": "Zero-dependency, zero-GC family of O(1) data structures that proves its constant: SparseSet (O(1) add/has/delete/clear/iterate), RingDeque (O(1) fixed-capacity numeric double-ended queue), UnionFind (near-O(1) amortized disjoint-set), and MonoDeque (O(1)-amortized monotonic deque for sliding-window min/max) with a throughput-invariance witness harness. Tree-shakeable named exports.",
  "type": "module",
  "main": "./O1.js",
  "module": "./O1.js",
  "types": "./O1.d.ts",
  "exports": {
    ".": {
      "types": "./O1.d.ts",
      "node": "./O1.js",
      "import": "./O1.js",
      "default": "./O1.js"
    }
  },
  "files": [
    "O1.js",
    "O1.d.ts",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js test/Bench.test.mjs",
    "test:types": "tsc -p test/types/tsconfig.json",
    "torture": "node --expose-gc test/torture.mjs",
    "witness": "node test/witness.mjs",
    "test:perf": "node --expose-gc --max-semi-space-size=4 --test test/perf/PerfGate.test.mjs",
    "bench": "node benchmark/Bench.mjs",
    "bench:report": "node benchmark/Bench.mjs && node benchmark/Report.mjs",
    "verify": "npm test && npm run test:types && npm run torture && npm run witness && npm run test:perf"
  },
  "keywords": [
    "o1",
    "big-o",
    "sparse-set",
    "ring-buffer",
    "circular-buffer",
    "deque",
    "ringdeque",
    "union-find",
    "disjoint-set",
    "dsu",
    "monotonic-deque",
    "monotonic-queue",
    "sliding-window",
    "min",
    "max",
    "data-structures",
    "zero-gc",
    "gc",
    "garbage-collection",
    "typed-array",
    "ecs",
    "performance",
    "lightweight",
    "zero-dependency"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.16.0",
    "@zakkster/lite-leak": "^1.10.0",
    "@zakkster/lite-perf-gate": "^1.4.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/PeshoVurtoleta/lite-o1#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-o1.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-o1/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "engines": {
    "node": ">=18"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "sideEffects": false
}
